# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string ("URI", use the pooled
# "Transaction" connection on port 6543 for the web service, direct 5432 is fine for one-off scripts)
DATABASE_URL=postgres://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# --- Twilio ---
# Twilio Console -> Account -> API keys & tokens
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number (or Messaging Service SID) that sends reports
TWILIO_FROM_NUMBER=+15555550123
# Optional: use a Messaging Service instead of a single From number (recommended once you have
# more than a couple hundred subscribers). If set, this takes priority over TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=

# --- Web server ---
PORT=3000
# Comma-separated list of origins allowed to POST to the signup endpoint (your Shopify domain(s))
SIGNUP_ALLOWED_ORIGINS=https://your-store.myshopify.com,https://www.yourbrand.com

# --- Scheduling (used by worker.js) ---
# IANA timezone used to decide "6am local" / "Sunday evening" for sends
REPORT_TIMEZONE=America/New_York
DAILY_SEND_CRON=0 6 * * *
WEEKLY_SEND_CRON=0 18 * * 0
